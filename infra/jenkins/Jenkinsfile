pipeline {
    agent {
        docker {
            image 'python:3.11-slim-bookworm'
            args '-u root'
        }
    }

    stages {
        stage('Setup') {
            steps {
                dir('edge') {
                    sh '''
                        apt-get update && apt-get install -y --no-install-recommends \
                            libgl1 libglib2.0-0
                        pip install --upgrade pip
                        pip install -r requirements.txt
                        pip install -r requirements-dev.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('edge') {
                    sh 'python -m pytest tests/ -v'
                }
            }
        }

        stage('Build Edge Docker Image (ARM64)') {
            agent { label 'built-in' }
            steps {
                sh '''
                    docker buildx build \
                        --platform linux/arm64 \
                        -t face-recognition-edge:${BUILD_NUMBER} \
                        -t face-recognition-edge:latest \
                        -f edge/Dockerfile edge/ \
                        --load
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline terminé.'
        }
        success {
            echo 'Tous les tests sont passés, image Docker ARM64 construite.'
        }
        failure {
            echo 'Échec du pipeline — voir les logs ci-dessus.'
        }
    }
}
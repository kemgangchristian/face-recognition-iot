pipeline {
    agent {
        docker {
            image 'python:3.11-slim-bookworm'
            args '-u root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        REGISTRY_IMAGE = 'ghcr.io/kemgangchristian/face-recognition-edge'
    }

    stages {
        stage('Setup') {
            steps {
                dir('edge') {
                    sh '''
                        apt-get update && apt-get install -y --no-install-recommends \
                            libgl1 libglib2.0-0 curl gnupg lsb-release
                        curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker.gpg
                        echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list
                        apt-get update && apt-get install -y docker-ce-cli docker-buildx-plugin
                        pip install --upgrade pip
                        pip install -r requirements.txt
                        pip install -r requirements-dev.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('edge') {
                    sh 'python -m pytest tests/ -v'
                }
            }
        }

        stage('Build Edge Docker Image (ARM64)') {
            steps {
                sh '''
                    docker buildx build \
                        --platform linux/arm64 \
                        -t ${REGISTRY_IMAGE}:${BUILD_NUMBER} \
                        -t ${REGISTRY_IMAGE}:latest \
                        -f edge/Dockerfile edge/ \
                        --load
                '''
            }
        }

        stage('Push to Registry') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'ghcr-credentials',
                    usernameVariable: 'GHCR_USER',
                    passwordVariable: 'GHCR_TOKEN'
                )]) {
                    sh '''
                        echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USER" --password-stdin
                        docker push ${REGISTRY_IMAGE}:${BUILD_NUMBER}
                        docker push ${REGISTRY_IMAGE}:latest
                    '''
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline terminé.'
        }
        success {
            echo 'Tous les tests sont passés, image Docker ARM64 construite et poussée.'
        }
        failure {
            echo 'Échec du pipeline — voir les logs ci-dessus.'
        }
    }
}